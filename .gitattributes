# Normalise line endings in the repo; PowerShell reads either ending, so checkouts may differ.
* text=auto
# bash is not so forgiving: a CR ends up in the command.
*.sh text eol=lf

*.png binary
*.zip binary

# The age test vectors are exact bytes: no line-ending conversion.
engine/tests/PSPhoenix.Engine.Tests/testkit/* binary
engine/tests/PSPhoenix.Engine.Tests/testkit/README.md text
