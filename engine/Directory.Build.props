<Project>
  <!-- Shared by the engine and its tests. net8.0 because PowerShell 7.4 runs on .NET 8; 7.5 (.NET 9)
       and later load it too. LangVersion is pinned so a newer SDK compiles the same language. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Also what lets the build report unused usings (IDE0005). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>WizX20</Authors>
    <Company>WizX20</Company>
    <Copyright>(c) 2026 WizX20. Business Source License 1.1.</Copyright>
    <Product>PSPhoenix</Product>
  </PropertyGroup>
</Project>
